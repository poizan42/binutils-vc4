# run tests for target VC4.

if [istarget vc4-*-*] then {
# test redefinitions
    run_dump_test "redef"
# vec80 accumulator modifiers: every SUB/DEC form must round-trip
    run_dump_test "accmods"
# test parsing of equ definitions
    run_dump_test "equ"
# test parsing of " and '
    run_dump_test "quotes"
    run_dump_test "simple_rts"
    run_dump_test "tracer_reduced"
    run_dump_test "test_values1"
    run_dump_test "opcodes_simple"
    run_dump_test "opcodes_push"
    run_dump_test "bne_1"
    run_dump_test "bne_2"
    run_dump_test "cmpreg"
    run_dump_test "shift-aliases"
    run_dump_test "conditional"
    run_dump_test "load_store"
    run_dump_test "switch"
    run_dump_test "switch2"
    run_dump_test "switch3"
    run_dump_test "switch4"
    run_dump_test "switch5"
    run_dump_test "vldst"
    run_dump_test "dash"
    run_dump_test "ldst"
    run_dump_test "ldsthiregind"
    run_dump_test "pcrel"
    run_dump_test "add16i"
    run_dump_test "addsubscale"
    run_dump_test "shiftedalu"
# vgetacc's 48-bit SETF (bit 38) must spell SETF, not the `+r0` addressing mode
    run_dump_test "getacc-setf"
# SETF on a row-B vector ALU op is 80-bit and must emit the full 10 bytes (#127 was a false report)
    run_dump_test "alu80-setf"
# the vector-multiply family (Vaop 48..61 + mul32); mnemonics need a signedness suffix (#130 non-bug)
    run_dump_test "vecmul"
# the leading `{wide}' pseudo-prefix forces + round-trips the 80-bit encoding of a dual-width op (#125)
    run_dump_test "wide"
# a bare `-` in the vector B slot must be an ERROR, not a silent r0
    run_list_test "bslot-dash" ""
}
